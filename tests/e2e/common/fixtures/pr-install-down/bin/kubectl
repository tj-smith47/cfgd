#!/usr/bin/env bash
# Records each call in $DOWN_LOG and exits 1 on one whose arguments match a
# glob in $DOWN_FAIL (patterns separated by |). A call whose arguments match
# the glob $DOWN_PRINT prints $DOWN_PRINT_OUT, as for objects still there;
# every other get prints nothing, as for objects that are gone, except a
# namespace phase read, which prints $DOWN_NAMESPACE (default Active; absent
# prints nothing), a list of the run's namespaces, which prints $DOWN_RUN_NS
# on each of its first $DOWN_RUN_NS_READS reads (default every read), and a
# pod list, which prints $DOWN_PODS.
echo "kubectl $*" >> "$DOWN_LOG"
IFS='|' read -ra fail_patterns <<<"${DOWN_FAIL:-}"
for pattern in "${fail_patterns[@]}"; do
    # shellcheck disable=SC2053 # the pattern is meant to glob
    [[ "$*" == $pattern ]] && exit 1
done
# shellcheck disable=SC2053 # the pattern is meant to glob
if [ -n "${DOWN_PRINT:-}" ] && [[ "$*" == $DOWN_PRINT ]]; then
    printf '%s\n' "$DOWN_PRINT_OUT"
fi
if [ "${DOWN_NAMESPACE:-}" != absent ] &&
    [[ "$*" == "get namespace "*" --ignore-not-found -o jsonpath={.status.phase}" ]]; then
    printf '%s\n' "${DOWN_NAMESPACE:-Active}"
fi
if [ -n "${DOWN_RUN_NS:-}" ] && [[ "$*" == "get namespaces -l "*" -o name" ]]; then
    reads=$(($(wc -l <"$DOWN_LOG.nsreads" 2>/dev/null || echo 0) + 1))
    echo >>"$DOWN_LOG.nsreads"
    if [ -z "${DOWN_RUN_NS_READS:-}" ] || [ "$reads" -le "$DOWN_RUN_NS_READS" ]; then
        printf '%s\n' "$DOWN_RUN_NS"
    fi
fi
if [ -n "${DOWN_PODS:-}" ] && [[ "$*" == "get pods -n "* ]]; then
    printf '%s\n' "$DOWN_PODS"
fi
exit 0
