{
  "depends": [
    "base"
  ],
  "directory": "/etc/cfgd/modules/dev-tools",
  "metadata": {
    "version": "1.4.0"
  },
  "name": "dev-tools",
  "source": "remote",
  "spec": {
    "aliases": [
      {
        "command": "git status",
        "name": "gs"
      },
      {
        "command": "ls -la",
        "name": "ll"
      }
    ],
    "depends": [
      "base"
    ],
    "env": [
      {
        "name": "EDITOR",
        "value": "nvim"
      },
      {
        "name": "GH_TOKEN",
        "value": "ghp_secret_token_value"
      }
    ],
    "files": [
      {
        "source": "vimrc",
        "target": "~/.vimrc"
      },
      {
        "source": "git@example.com:org/dotfiles.git//tmux.conf",
        "target": "~/.tmux.conf"
      }
    ],
    "packages": [
      {
        "name": "ripgrep"
      },
      {
        "name": "winget-only-tool",
        "platforms": [
          "windows"
        ]
      },
      {
        "minVersion": "1.0",
        "name": "obscure-tool",
        "prefer": [
          "nix"
        ]
      }
    ],
    "scripts": {
      "onChange": [],
      "onDrift": [
        "notify-send 'dev-tools drifted'"
      ],
      "postApply": [
        "echo 'post-apply hook ran'",
        "systemctl --user daemon-reload"
      ],
      "postReconcile": [],
      "preApply": [
        "mkdir -p ~/.config/dev-tools"
      ],
      "preReconcile": []
    }
  }
}