{
  "acceptRecommended": true,
  "autoApply": false,
  "branch": "main",
  "manifest": {
    "description": "Team-wide baseline",
    "modules": [
      "dev-tools",
      "shell"
    ],
    "name": "team-config",
    "profiles": [],
    "version": "3.1.0"
  },
  "modules": [
    "dev-tools",
    "shell"
  ],
  "name": "team-config",
  "pinVersion": "v1.2.3",
  "policy": {
    "allowedTargetPaths": [
      "~/.config/**",
      "~/.bashrc"
    ],
    "encryption": {
      "backend": "sops",
      "mode": "Always",
      "requiredTargets": [
        "secrets/**"
      ]
    },
    "requireSignedCommits": true,
    "scriptsAllowed": false,
    "secretsReadAllowed": false,
    "signedCommitsBypassed": true,
    "systemChangesAllowed": false
  },
  "priority": 100,
  "profile": "team",
  "syncInterval": "1h",
  "url": "https://github.com/team/config"
}