# Ignore everything
*

# Allow Rust source
!Cargo.toml
!Cargo.lock
!crates/
!crates/**

# cfgd-core embeds these repo-root example manifests via include_str! at
# compile time, so every image that builds a cfgd-core-dependent binary needs
# them in the build context.
!examples/
!examples/**

# Allow build files
!Dockerfile
!Dockerfile.*

# Allow pre-built binaries (release Docker builds)
!binaries/
!binaries/**

# Allow tests
!tests/
!tests/**

# Allow README for labels
!README.md

# Allow the demo container's assets: demo/Dockerfile is read directly by
# `docker build -f` and never needs this file, but demo/bin/cfgd (a host-built
# binary staged there before `docker build` — see demo/Dockerfile for why it
# isn't copied straight out of target/) does.
!demo/
!demo/**

# Re-ignore build artifacts inside allowed dirs
target/
