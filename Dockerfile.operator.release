FROM debian:bookworm-slim

# openssh-client (ssh-keygen) and gnupg (gpg) are runtime deps of key-based device
# enrollment: the gateway shells out to `ssh-keygen -Y verify` / `gpg --verify` to check a
# device's signed challenge (gateway/api/enroll.rs). Without them, verification fails at the
# subprocess even though the HTTP surface accepts the request.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssh-client \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETOS=linux
ARG TARGETARCH

# cosign is a runtime dependency of the Module controller: it verifies each
# Module's artifact against the key the CRD declares, and without the binary
# every Module reports its signature as `unknown`. Pinned to the same release
# the e2e workflow installs, and checked against the digest that release
# publishes for the arch being built.
ARG COSIGN_VERSION=v2.4.3
ARG COSIGN_SHA256_amd64=caaad125acef1cb81d58dcdc454a1e429d09a750d1e9e2b3ed1aed8964454708
ARG COSIGN_SHA256_arm64=bd0f9763bca54de88699c3656ade2f39c9a1c7a2916ff35601caf23a79be0629
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) sha="${COSIGN_SHA256_amd64}" ;; \
      arm64) sha="${COSIGN_SHA256_arm64}" ;; \
      *) echo "no pinned cosign digest for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 \
      -o /usr/local/bin/cosign \
      "https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-${TARGETOS}-${TARGETARCH}"; \
    echo "${sha}  /usr/local/bin/cosign" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/cosign

RUN adduser --disabled-password --gecos "" --uid 1000 cfgd

COPY --chmod=0755 ${TARGETOS}/${TARGETARCH}/cfgd-operator /usr/local/bin/cfgd-operator

USER cfgd
WORKDIR /home/cfgd

ENTRYPOINT ["cfgd-operator"]
