FROM rust:1.97-slim-bookworm AS chef
RUN cargo install cargo-chef --locked --version 0.1.71
WORKDIR /build

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config perl make \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /build/recipe.json recipe.json
# Cook both binaries' deps in one pass — they share the cfgd-operator crate
# graph, so a single chef cook covers both. Avoids the previous host-side
# `cargo build --bin cfgd-gen-crds` + this image's `cargo build --bin
# cfgd-operator` double-compile in tests/e2e/setup-cluster.sh.
RUN cargo chef cook --release --recipe-path recipe.json --bin cfgd-operator --bin cfgd-gen-crds
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# cfgd-core's generate module embeds these repo-root manifests via include_str!.
COPY examples/ examples/
RUN cargo build --release --bin cfgd-operator --bin cfgd-gen-crds

# Named stage that emits the generated CRD YAML. setup-cluster.sh extracts
# it via `docker buildx build --target=crds --output=type=local,dest=...`
# so the e2e setup no longer needs the host-side cargo build of gen-crds.
FROM scratch AS crds
COPY --from=builder /build/target/release/cfgd-gen-crds /cfgd-gen-crds

# --- Runtime ---

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# cosign is a runtime dependency of the Module controller: it verifies each
# Module's artifact against the key the CRD declares, and without the binary
# every Module reports its signature as `unknown`. Pinned to the same release
# the e2e workflow installs, and checked against the digest that release
# publishes.
ARG COSIGN_VERSION=v2.4.3
ARG COSIGN_SHA256=caaad125acef1cb81d58dcdc454a1e429d09a750d1e9e2b3ed1aed8964454708
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 \
    -o /usr/local/bin/cosign \
    "https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-amd64" \
    && echo "${COSIGN_SHA256}  /usr/local/bin/cosign" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/cosign

RUN adduser --disabled-password --gecos "" --uid 1000 cfgd

COPY --from=builder /build/target/release/cfgd-operator /usr/local/bin/cfgd-operator

USER cfgd
WORKDIR /home/cfgd

ENTRYPOINT ["cfgd-operator"]
